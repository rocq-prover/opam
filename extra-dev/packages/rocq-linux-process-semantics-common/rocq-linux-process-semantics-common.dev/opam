  "dune" {>= "3.23"}
  "rocq-core" {>= "9.2"}
  "rocq-stdlib" {>= "9.0"}
  "rocq-stdpp" {>= "1.13.0"}
  "rocq-stdpp-bitvector" {>= "1.13.0"}
  "coq-flocq" {>= "4.2"}
  "rocq-read-file" {>= "0.0.2"}
  "rocq-linux-process-semantics-core" {= version}
]
