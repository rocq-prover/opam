dev-repo: "git+https://github.com/peregrine-project/rocq-typed-extraction.git"
bug-reports: "https://github.com/peregrine-project/rocq-typed-extraction/issues"
doc: "https://peregrine-project.github.io/rocq-typed-extraction/toc.html"

depends: [
  "rocq-core" {= "dev"}
  "rocq-stdlib" {>= "9.0"}
  "rocq-metarocq-utils" {>= "1.5.1"}
  "rocq-metarocq-common" {>= "1.5.1"}
  "rocq-metarocq-template" {>= "1.5.1"}
  "rocq-metarocq-template-pcuic" {>= "1.5.1"}
  "rocq-metarocq-pcuic" {>= "1.5.1"}
  "rocq-metarocq-safechecker" {>= "1.5.1"}
  "rocq-metarocq-erasure" {>= "1.5.1"}
]

build: [
  ["bash" "./configure.sh"]
  [make "-j" "%{jobs}%" "-C" "common"]
]

install: [
  [make "-C" "common" "install"]
]

